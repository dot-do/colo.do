{
  "name": "colo.do",
  "version": "0.1.0",
  "description": "colo.do - Location-aware Durable Objects managed service",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "scripts": {
    "build": "pnpm build:core && tsc",
    "build:core": "cd core && pnpm build",
    "dev": "tsc --watch",
    "test": "vitest",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist && cd core && rm -rf dist",
    "deploy": "wrangler deploy",
    "prepublishOnly": "pnpm build",
    "version": "changeset version",
    "release": "pnpm build && changeset publish"
  },
  "keywords": [
    "cloudflare",
    "durable-objects",
    "colocation",
    "edge",
    "rpc"
  ],
  "author": "dot.do",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/dot-do/colo.do.git"
  },
  "homepage": "https://colo.do",
  "devDependencies": {
    "@changesets/cli": "^2.29.8",
    "@cloudflare/workers-types": "^4.20250121.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8",
    "wrangler": "^4.0.0"
  },
  "dependencies": {
    "@dotdo/colo": "^0.1.0"
  }
}
