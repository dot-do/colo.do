{
  "name": "colo.do",
  "version": "0.1.0",
  "description": "Location-aware Durable Objects - create, target, and manage DOs in specific Cloudflare colocations",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tiny": {
      "types": "./dist/tiny.d.ts",
      "import": "./dist/tiny.js"
    },
    "./minimal": {
      "types": "./dist/location-only.d.ts",
      "import": "./dist/location-only.js"
    },
    "./worker": {
      "types": "./dist/worker.d.ts",
      "import": "./dist/worker.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "cloudflare",
    "durable-objects",
    "colocation",
    "edge",
    "rpc"
  ],
  "author": "dot.do",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/dot-do/colo.do.git"
  },
  "homepage": "https://colo.do",
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250121.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  },
  "peerDependencies": {
    "@cloudflare/workers-types": ">=4.0.0"
  },
  "peerDependenciesMeta": {
    "@cloudflare/workers-types": {
      "optional": true
    }
  },
  "dependencies": {
    "capnweb": "^0.4.0"
  }
}
